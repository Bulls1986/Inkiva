{
  "$schema": "./thresholds.schema.json",
  "$id": "https://github.com/Bulls1986/Inkiva/blob/develop/perf/soak/thresholds-pr-smoke.json",
  "schemaVersion": 1,
  "comparison": "relative",
  "maxRelativeRegression": 0.1,
  "regressionPolicy": "blocking",
  "absoluteGates": [
    {
      "id": "soak-duration",
      "name": "soak.durationMs",
      "unit": "ms",
      "operator": "gte",
      "limit": 600000
    },
    {
      "id": "stability-crash",
      "name": "stability.crash",
      "unit": "count",
      "operator": "eq",
      "limit": 0
    },
    {
      "id": "stability-renderer-crash",
      "name": "stability.rendererCrash",
      "unit": "count",
      "operator": "eq",
      "limit": 0
    },
    {
      "id": "stability-oom",
      "name": "stability.oom",
      "unit": "count",
      "operator": "eq",
      "limit": 0
    },
    {
      "id": "memory-linear-growth",
      "name": "memory.heapLinearGrowth",
      "unit": "count",
      "operator": "eq",
      "limit": 0
    },
    {
      "id": "stability-cpu-runaway",
      "name": "stability.cpuRunaway",
      "unit": "count",
      "operator": "eq",
      "limit": 0
    },
    {
      "id": "stability-renderer-hang",
      "name": "stability.rendererHang",
      "unit": "count",
      "operator": "eq",
      "limit": 0
    }
  ]
}

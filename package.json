{
  "name": "inkiva-monorepo",
  "version": "0.4.0",
  "description": "Inkiva monorepo root",
  "private": true,
  "homepage": "https://www.inkiva.net",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "postinstall": "tsx scripts/postinstall.ts",
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "minify-locales": "tsx scripts/minify-locales.ts",
    "rebuild-native": "pnpm --filter inkiva rebuild-native",
    "start": "pnpm --filter inkiva start",
    "dev": "pnpm --filter inkiva dev",
    "build": "pnpm --filter inkiva build",
    "build:unpack": "pnpm --filter inkiva build:unpack",
    "build:win": "pnpm --filter inkiva build:win",
    "build:win:x64": "pnpm --filter inkiva build:win:x64",
    "build:mac": "pnpm --filter inkiva build:mac",
    "build:mac:x64": "pnpm --filter inkiva build:mac:x64",
    "build:mac:arm64": "pnpm --filter inkiva build:mac:arm64",
    "perf:inspect": "pnpm --filter inkiva perf:inspect",
    "perf:inspect-brk": "pnpm --filter inkiva perf:inspect-brk",
    "test": "pnpm --filter inkiva test",
    "test:unit": "pnpm --filter inkiva test:unit",
    "test:lifecycle": "pnpm --filter @muyajs/core test:lifecycle && pnpm --filter inkiva test:lifecycle",
    "test:e2e": "pnpm --filter inkiva test:e2e",
    "test:e2e:virtualization": "pnpm --filter inkiva test:e2e:virtualization",
    "test:e2e:perf": "pnpm --filter inkiva test:e2e:perf",
    "test:e2e:perf:fast": "pnpm --filter inkiva test:e2e:perf:fast",
    "test:perf:fast": "node --import tsx --test perf/soak/fast-policy.spec.ts perf/soak/fast-runner.spec.ts",
    "test:release": "node --import tsx --test scripts/verifyUpdateArtifacts.test.ts",
    "typecheck": "pnpm --filter inkiva typecheck",
    "typecheck:watch": "pnpm --filter inkiva typecheck:watch",
    "check": "pnpm lint && pnpm typecheck",
    "gen-third-party": "tsx scripts/generateThirdPartyLicense.ts",
    "validate-licenses": "tsx scripts/validateLicenses.ts",
    "verify-update-artifacts": "tsx scripts/verifyUpdateArtifacts.ts",
    "test:perf:gate": "node --import tsx --test perf/gate/*.spec.ts",
    "test:e2e:gate": "pnpm --filter inkiva test:e2e:gate",
    "test:e2e:gate:large": "pnpm --filter inkiva test:e2e:gate:large"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.29.7",
    "@eslint/js": "^9.39.4",
    "electron": "~42.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-html": "^8.1.4",
    "eslint-plugin-i18n-json": "^4.0.1",
    "eslint-plugin-jsonc": "^3.2.0",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.6.0",
    "license-checker": "^25.0.1",
    "neostandard": "^0.13.0",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "typescript-eslint": "^8.61.1",
    "vue-eslint-parser": "^10.4.1"
  },
  "license": "GPL-3.0"
}
